<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Sessions.App/Sessions.App.csproj" />
    <ProjectReference Include="../Sessions.LaunchProbe/Sessions.LaunchProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyLaunchProbe" AfterTargets="Build">
    <ItemGroup>
      <LaunchProbeFiles Include="../Sessions.LaunchProbe/bin/$(Configuration)/net10.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(LaunchProbeFiles)" DestinationFolder="$(OutDir)launch-probe" SkipUnchangedFiles="true" />
  </Target>
</Project>
