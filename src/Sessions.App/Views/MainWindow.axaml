<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sessions.App.ViewModels"
        xmlns:views="using:Sessions.App.Views"
        x:Class="Sessions.App.Views.MainWindow" x:DataType="vm:MainViewModel" x:CompileBindings="True"
        Width="{StaticResource Measure1120}" Height="{StaticResource Measure800}" MinWidth="{StaticResource Measure640}" MinHeight="{StaticResource Measure480}"
        WindowStartupLocation="CenterScreen" Title="Sessions" Icon="/Assets/sessions.ico">
    <LayoutTransformControl x:Name="AppearanceRoot">
    <Grid>
    <Grid RowDefinitions="Auto,*" IsEnabled="{Binding IsMainContentEnabled}">
        <Border IsVisible="{Binding !HasSessions}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SessionBorder}" BorderThickness="{StaticResource Inset0x0x0x1}" Padding="{StaticResource Inset24x16}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Measure12}" VerticalAlignment="Center">
                    <views:BrandMark Width="{StaticResource Measure30}" Height="{StaticResource Measure30}" />
                    <TextBlock Text="Sessions" FontSize="{DynamicResource FontSubtitleSize}" FontWeight="{StaticResource WeightStrong}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" x:Name="EmptySettingsButton" Content="Settings" Click="SettingsClicked" AutomationProperties.Name="Settings" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Border Classes="sidebar" IsVisible="{Binding HasSessions}" Background="{DynamicResource SessionSidebar}"
                    BorderBrush="{DynamicResource SessionBorder}" BorderThickness="{StaticResource Inset0x0x1x0}">
                <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource Inset12x20x12x20}">
                    <StackPanel Spacing="{StaticResource Measure16}" Margin="{StaticResource Inset4x0x4x20}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Measure12}" Margin="{StaticResource Inset4x0x0x20}">
                            <views:BrandMark Width="{StaticResource Measure26}" Height="{StaticResource Measure26}" />
                            <TextBlock Text="Sessions" FontSize="{DynamicResource FontSubtitleSize}" FontWeight="{StaticResource WeightHeading}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="YOUR SESSIONS" Classes="eyebrow" /><TextBlock Grid.Column="1" Text="{Binding Sessions.Count}" Classes="muted" FontSize="{DynamicResource FontMicroSize}" /></Grid>
                        <Button x:Name="NewSessionButton" Content="+  New Session" Classes="primary" HorizontalAlignment="Stretch" Click="EditRequested"
                                HorizontalContentAlignment="Center" Command="{Binding NewSessionCommand}">
                            <Button.ContentTemplate>
                                <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource OnBrandBrush}" /></DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="SessionList" Classes="sessions" ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding SelectedSession}" IsEnabled="{Binding CanBrowse}"
                             AutomationProperties.Name="Your Sessions">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem" x:DataType="vm:SessionViewModel">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="ToolTip.Tip" Value="{Binding Name}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionViewModel">
                                <Grid ColumnDefinitions="36,*">
                                    <Border Classes="sessionAvatar" Width="{StaticResource Measure34}" Height="{StaticResource Measure34}" Background="{DynamicResource PanelAltBrush}" CornerRadius="{StaticResource Round10}">
                                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="{StaticResource WeightStrong}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource Measure3}" Margin="{StaticResource Inset7x0x0x0}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="{StaticResource WeightStrong}" />
                                        <TextBlock Text="{Binding AppCount}" Classes="muted" FontSize="{DynamicResource FontMicroSize}" />
                                        <TextBlock Text="● Active" IsVisible="{Binding IsActive}" Foreground="{DynamicResource RunningBrush}" FontSize="{DynamicResource FontMicroSize}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Spacing="{StaticResource Measure8}" Margin="{StaticResource Inset4x20x4x0}">
                        <Button x:Name="SettingsButton" Content="Settings" Click="SettingsClicked" HorizontalAlignment="Stretch" AutomationProperties.Name="Settings" />
                        <TextBlock Text="Saved locally. Always yours." Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <ScrollViewer Classes="runtimeStatus" Classes.cleanup="{Binding NeedsCleanup}" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <Border x:Name="PreferencesWarning" IsVisible="False" Classes="surface" Padding="{StaticResource Inset16}" Margin="{StaticResource Inset28x20x28x0}">
                    <StackPanel Spacing="{StaticResource Measure8}">
                        <TextBlock Text="Your preferences couldn't be loaded. Open Settings to retry or reset them." TextWrapping="Wrap" Foreground="{DynamicResource SessionError}" AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Open Settings" Click="SettingsClicked" />
                    </StackPanel>
                </Border>
                <Border IsVisible="{Binding HasError}" Margin="{StaticResource Inset28x20x28x0}" Classes="surface" Padding="{StaticResource Inset16}">
                    <StackPanel Spacing="{StaticResource Measure10}">
                        <TextBlock Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource SessionError}" TextWrapping="Wrap" />
                        <Button Content="Try loading again" Command="{Binding LoadCommand}" IsVisible="{Binding CanRetryLoad}" />
                    </StackPanel>
                </Border>
                <Border IsVisible="{Binding HasRuntime}" Margin="{StaticResource Inset20x16x20x0}" Classes="surface runtime" Classes.running="{Binding HasActiveRun}" Padding="{StaticResource Inset16}">
                    <DockPanel LastChildFill="True">
                        <StackPanel Classes="runtimeActions" Spacing="{StaticResource Measure8}" VerticalAlignment="Center">
                            <Button x:Name="EndSessionButton" Content="{Binding EndLabel}" Command="{Binding EndSessionCommand}" IsVisible="{Binding HasActiveRun}" Classes="danger" />
                            <Button Content="View active Session" Command="{Binding ViewActiveSessionCommand}" IsVisible="{Binding ShowActiveNavigation}" Classes="quiet" />
                            <Button Content="Finish and leave apps open" Command="{Binding FinishSessionCommand}" IsVisible="{Binding NeedsCleanup}" Classes="quiet" />
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource Measure8}">
                            <TextBlock Text="{Binding RuntimeTitle}" AutomationProperties.LiveSetting="Polite" FontWeight="{StaticResource WeightHeading}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Runtime.Message}" AutomationProperties.LiveSetting="Polite" Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StartupFocusMessage}" IsVisible="{Binding HasStartupFocusMessage}" AutomationProperties.LiveSetting="Polite" Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding CleanupApps}" IsVisible="{Binding NeedsCleanup}">
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CleanupAppViewModel">
                                    <StackPanel Spacing="{StaticResource Measure8}" Margin="{StaticResource Inset0x3}">
                                        <TextBlock Text="{Binding Name}" FontWeight="{StaticResource WeightStrong}" TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <Button Content="Bring forward" Classes="quiet" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).FocusCleanupAppCommand}" CommandParameter="{Binding}" Margin="{StaticResource Inset0x0x10x8}" />
                                            <Button Content="Force quit…" Classes="danger" Click="ForceQuitRequested" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestForceQuitCommand}" CommandParameter="{Binding}" Margin="{StaticResource Inset0x0x0x8}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding CleanupFocusMessage}" IsVisible="{Binding NeedsCleanup}" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                    </DockPanel>
                </Border>
                </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1">
                    <StackPanel IsVisible="{Binding ShowLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource Measure12}">
                        <ProgressBar IsIndeterminate="True" Width="{StaticResource Measure180}" />
                        <TextBlock Text="Loading your Sessions…" Classes="muted" />
                    </StackPanel>
                    <ScrollViewer IsVisible="{Binding IsEmpty}" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="{StaticResource Measure800}" Margin="{StaticResource Inset32x48x32x32}" Spacing="{StaticResource Measure24}">
                            <Border Width="{StaticResource Measure66}" Height="{StaticResource Measure66}" CornerRadius="{StaticResource Round18}" Background="{DynamicResource SessionSelection}" HorizontalAlignment="Left">
                                <views:BrandMark Width="{StaticResource Measure40}" Height="{StaticResource Measure40}" />
                            </Border>
                            <StackPanel Spacing="{StaticResource Measure14}">
                                <TextBlock Text="Get your apps together." FontSize="{DynamicResource FontDisplayLSize}" FontWeight="{StaticResource WeightHeading}" TextWrapping="Wrap" LineHeight="{DynamicResource FontDisplayLLineHeight}" />
                                <TextBlock Text="Work, gaming, or a little time to create. Bring the apps you need together in a Session, ready when you are."
                                           Classes="muted" FontSize="{DynamicResource FontSubtitleSize}" TextWrapping="Wrap" LineHeight="{DynamicResource FontSubtitleLineHeight}" />
                            </StackPanel>
                            <Button x:Name="CreateFirstButton" Content="+  Create your first Session" Classes="primary" Click="EditRequested" Command="{Binding NewSessionCommand}" />
                            <UniformGrid Classes="explainers steps" Margin="{StaticResource Inset0x4x0x0}">
                                <Border Classes="surface" Padding="{StaticResource Inset20}" Margin="{StaticResource Inset0x0x8x8}"><StackPanel Spacing="{StaticResource Measure7}"><TextBlock Text="01  Make it yours" FontWeight="{StaticResource WeightStrong}" TextWrapping="Wrap" /><TextBlock Text="Name your context." Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Classes="surface" Padding="{StaticResource Inset20}" Margin="{StaticResource Inset0x0x8x8}"><StackPanel Spacing="{StaticResource Measure7}"><TextBlock Text="02  Add your apps" FontWeight="{StaticResource WeightStrong}" TextWrapping="Wrap" /><TextBlock Text="Set what opens, and when." Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Classes="surface" Padding="{StaticResource Inset20}" Margin="{StaticResource Inset0x0x0x8}"><StackPanel Spacing="{StaticResource Measure7}"><TextBlock Text="03  Settle in" FontWeight="{StaticResource WeightStrong}" TextWrapping="Wrap" /><TextBlock Text="Your context is ready to go." Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" /></StackPanel></Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid IsVisible="{Binding ShowDetails}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel DataContext="{Binding SelectedSession, DataType={x:Type vm:MainViewModel}}" x:DataType="vm:SessionViewModel"
                                        Classes="detailContent" Spacing="{StaticResource Measure24}" MaxWidth="{StaticResource Measure1000}">
                                <Border Classes="surface hero" Padding="{StaticResource Inset20}">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel Classes="heroActions" Orientation="Horizontal" Spacing="{StaticResource Measure12}" VerticalAlignment="Center"
                                                        IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowStart}">
                                                <Button Content="Start Session" Classes="primary" IsVisible="{Binding HasApps}"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StartSessionCommand}" />
                                                <Button x:Name="EditSessionButton" Content="Edit Session" Classes="quiet" Click="EditRequested"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EditSessionCommand}" />
                                            </StackPanel>
                                            <Grid ColumnDefinitions="Auto,*" Margin="{StaticResource Inset0x0x16x0}">
                                                <Border Width="{StaticResource Measure56}" Height="{StaticResource Measure56}" Classes="heroAvatar" Classes.active="{Binding IsActive}" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Initial}" FontSize="{DynamicResource FontDisplayMSize}" FontWeight="{StaticResource WeightHeading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="{StaticResource Measure4}" Margin="{StaticResource Inset16x0x0x0}">
                                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontDisplayMSize}" FontWeight="{StaticResource WeightHeading}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding AppCount}" Classes="muted" FontSize="{DynamicResource FontMicroSize}" />
                                                    <TextBlock Text="Active Session" IsVisible="{Binding IsActive}" Foreground="{DynamicResource RunningBrush}" FontSize="{DynamicResource FontMicroSize}" />
                                                    <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" Margin="{StaticResource Inset0x4x0x0}" />
                                                </StackPanel>
                                            </Grid>
                                        </DockPanel>
                                </Border>
                                <TextBlock x:Name="StartHint" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).StartHint}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).HasStartHint}"
                                           Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <StackPanel Spacing="{StaticResource Measure12}">
                                    <StackPanel Spacing="{StaticResource Measure4}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Apps in this Session" Classes="section" />
                                            <TextBlock Grid.Column="1" Text="{Binding AppCount}" Classes="muted" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding StartupSummary}" IsVisible="{Binding HasApps}" Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border IsVisible="{Binding HasApps}">
                                        <ItemsControl ItemsSource="{Binding Apps}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="{StaticResource Measure8}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SessionAppRow">
                                                    <Border Classes="surface appCard" Padding="{StaticResource Inset14x12}"><Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                                        <Border Classes="appTile" Width="{StaticResource Measure44}" Height="{StaticResource Measure44}" Margin="{StaticResource Inset0x0x14x0}" VerticalAlignment="Top"><views:AppIcon AppName="{Binding Name}" ExecutablePath="{Binding ExecutablePath}" /></Border>
                                                        <StackPanel Grid.Column="1" Spacing="{StaticResource Measure4}" VerticalAlignment="Center" Margin="{StaticResource Inset0x0x12x0}">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="{StaticResource WeightStrong}" ToolTip.Tip="{Binding ExecutablePath}" />
                                                            <TextBlock Text="{Binding Role}" IsVisible="{Binding HasRole}" Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" /><TextBlock Text="{Binding PathSummary}" Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ExecutablePath}" />
                                                            <TextBlock Text="{Binding RunMessage}" IsVisible="{Binding HasRunMessage}" Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <WrapPanel Classes="appStatus" VerticalAlignment="Center" ItemSpacing="{StaticResource Measure8}" LineSpacing="{StaticResource Measure8}">
                                                        <Button Classes="runningStatus" Command="{Binding FocusCommand}" MinHeight="{StaticResource Measure44}" IsVisible="{Binding HasWindow}"
                                                                Padding="{StaticResource Inset10x8}" VerticalAlignment="Center" FontSize="{DynamicResource FontMicroSize}"
                                                                ToolTip.Tip="{Binding StatusHint}" AutomationProperties.Name="{Binding StatusHint}">
                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Measure8}">
                                                                <Ellipse Width="{StaticResource Measure8}" Height="{StaticResource Measure8}" Fill="{DynamicResource RunningBrush}" IsVisible="{Binding IsRunning}" />
                                                                <Ellipse Width="{StaticResource Measure8}" Height="{StaticResource Measure8}" Fill="{DynamicResource SessionMuted}" IsVisible="{Binding !IsRunning}" />
                                                                <TextBlock Text="{Binding StatusLabel}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Classes="quiet" Command="{Binding LaunchCommand}" MinHeight="{StaticResource Measure44}" IsVisible="{Binding HasLaunchAction}"
                                                                Padding="{StaticResource Inset10x8}" VerticalAlignment="Center" FontSize="{DynamicResource FontMicroSize}"
                                                                ToolTip.Tip="{Binding StatusHint}" AutomationProperties.Name="{Binding StatusHint}">
                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Measure8}">
                                                                <TextBlock Text="▶" Classes="muted" FontSize="{DynamicResource FontMicroSize}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusLabel}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Border x:Name="PassiveStatus" Classes="statusChip" Classes.running="{Binding IsRunning}" IsVisible="{Binding HasPassiveStatus}"
                                                                VerticalAlignment="Center" ToolTip.Tip="{Binding StatusHint}" AutomationProperties.Name="{Binding StatusHint}">
                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Measure8}" VerticalAlignment="Center">
                                                                <Ellipse Width="{StaticResource Measure8}" Height="{StaticResource Measure8}" Fill="{DynamicResource RunningBrush}" IsVisible="{Binding IsRunning}" />
                                                                <Ellipse Width="{StaticResource Measure8}" Height="{StaticResource Measure8}" Fill="{DynamicResource SessionMuted}" IsVisible="{Binding !IsRunning}" />
                                                                <TextBlock Text="{Binding StatusLabel}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Button x:Name="CloseAppButton" Content="Close…" Classes="danger" IsVisible="{Binding IsRunning}"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestCloseAppCommand}" CommandParameter="{Binding}"
                                                                Click="CloseAppRequested" AutomationProperties.Name="{Binding CloseHint}" ToolTip.Tip="{Binding CloseHint}"
                                                                VerticalAlignment="Center" MinHeight="{StaticResource Measure44}" Padding="{StaticResource Inset10x8}" FontSize="{DynamicResource FontMicroSize}" />
                                                        </WrapPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                                                        <TextBlock x:Name="LaunchFeedback" Text="{Binding LaunchMessage}" AutomationProperties.LiveSetting="Polite"
                                                                   IsVisible="{Binding HasLaunchMessage}" Classes="muted"
                                                                   TextWrapping="Wrap" FontSize="{DynamicResource FontMicroSize}" Margin="{StaticResource Inset0x8x0x0}" />
                                                        <TextBlock x:Name="CloseFeedback" Text="{Binding CloseMessage}" AutomationProperties.LiveSetting="Polite"
                                                                   IsVisible="{Binding HasCloseMessage}" Classes="muted closeFeedback" Classes.error="{Binding IsCloseError}"
                                                                   TextWrapping="Wrap" FontSize="{DynamicResource FontMicroSize}" Margin="{StaticResource Inset0x8x0x0}" />
                                                        <TextBlock x:Name="AppErrorFeedback" Text="{Binding FocusMessage}" AutomationProperties.LiveSetting="Polite"
                                                                   IsVisible="{Binding HasFocusMessage}" Foreground="{DynamicResource SessionError}"
                                                                   TextWrapping="Wrap" FontSize="{DynamicResource FontMicroSize}" Margin="{StaticResource Inset0x8x0x0}" />
                                                        </StackPanel>
                                                    </Grid></Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <Border Classes="surface" Padding="{StaticResource Inset22}" IsVisible="{Binding !HasApps}">
                                        <TextBlock Text="No apps added yet. Edit this Session to choose what opens." Classes="muted" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).AppInteractionHint}" Classes="muted" FontSize="{DynamicResource FontMicroSize}"
                                               TextWrapping="Wrap" IsVisible="{Binding HasApps}" />
                                </StackPanel>
                                <Border Classes="surface" Padding="{StaticResource Inset20}" IsVisible="{Binding HasAudioChoices}">
                                    <StackPanel Spacing="{StaticResource Measure8}"><TextBlock Text="Session audio" FontWeight="{StaticResource WeightStrong}" /><TextBlock Text="{Binding AudioSummary}" TextWrapping="Wrap" /></StackPanel>
                                </Border>
                                <UniformGrid Classes="explainers" ColumnSpacing="{StaticResource Measure8}" RowSpacing="{StaticResource Measure8}">
                                    <Border Classes="surface" Padding="{StaticResource Inset16}"><StackPanel Spacing="{StaticResource Measure6}">
                                        <TextBlock Text="When you're finished" FontWeight="{StaticResource WeightStrong}" />
                                        <TextBlock x:Name="EndSummary" TextWrapping="Wrap"><Run Text="{Binding EndSummary}" /><Run Text=" End Session asks its apps to close. Apps waiting for you stay open. Automatic force quit is available per app in its options." Foreground="{DynamicResource TextMutedBrush}" /></TextBlock>
                                    </StackPanel></Border>
                                    <Border Classes="surface" Padding="{StaticResource Inset16}"><StackPanel Spacing="{StaticResource Measure6}">
                                        <TextBlock Text="Already open stays open" FontWeight="{StaticResource WeightStrong}" />
                                        <TextBlock Text="Apps running before you start stay independent of this Session. Ending it leaves them open." Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel></Border>
                                </UniformGrid>
                                <WrapPanel ItemSpacing="{StaticResource Measure12}" LineSpacing="{StaticResource Measure8}">
                                    <Button x:Name="DuplicateSessionButton" Content="Duplicate Session" Classes="quiet" Click="EditRequested"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DuplicateSessionCommand}" />
                                    <Button x:Name="DeleteSessionButton" Content="Delete Session…" Classes="quiet"
                                            Foreground="{DynamicResource SessionError}"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RequestDeleteSessionCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid IsVisible="{Binding IsEditing}" RowDefinitions="*,Auto">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding !IsBusy}">
                            <views:SessionEditorView x:Name="EditorView" DataContext="{Binding Editor}" Classes="editorContent" MaxWidth="{StaticResource Measure1000}" />
                        </ScrollViewer>
                        <Border Grid.Row="1" Classes="editorFooter" BorderBrush="{DynamicResource SessionBorder}" BorderThickness="{StaticResource Inset0x1x0x0}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Button x:Name="ReviewFieldsButton" Content="Review fields" Classes="quiet" Click="ReviewFieldsClicked" IsVisible="{Binding !Editor.CanSave}" IsEnabled="{Binding !IsBusy}" AutomationProperties.HelpText="{Binding Editor.ValidationMessage}" ToolTip.Tip="{Binding Editor.ValidationMessage}" HorizontalAlignment="Left" Margin="{StaticResource Inset0x0x12x0}" />
                                <TextBlock IsVisible="{Binding Editor.CanSave}" Text="Nothing opens until you start." Classes="muted" FontSize="{DynamicResource FontMicroSize}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="{StaticResource Inset0x0x16x0}" />
                                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelEditCommand}" Classes="quiet" Margin="{StaticResource Inset0x0x12x0}" />
                                <Button Grid.Column="2" Content="{Binding Editor.SaveLabel}" Command="{Binding SaveSessionCommand}" Classes="primary" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
    <Border IsVisible="{Binding IsEndConfirmation}" Background="{DynamicResource OverlayBrush}">
        <Border Classes="surface modal" MaxWidth="{StaticResource Measure640}" MaxHeight="{StaticResource Measure520}" Margin="{StaticResource Inset32}" Padding="{StaticResource Inset28}" HorizontalAlignment="Center" VerticalAlignment="Center"
                KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="{Binding EndConfirmationTitle}">
            <Border.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding CancelEndSessionCommand}" /></Border.KeyBindings>
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="{StaticResource Measure14}">
                        <TextBlock Text="{Binding EndConfirmationTitle}" FontSize="{DynamicResource FontTitleSize}" FontWeight="{StaticResource WeightHeading}" TextWrapping="Wrap" />
                        <TextBlock Text="Save your work before continuing." FontWeight="{StaticResource WeightStrong}" TextWrapping="Wrap" />
                        <TextBlock Text="Sessions will ask its apps to close. Apps that stay running will wait for you to save your work or decide what to do." TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AutomaticForceQuitWarning}" IsVisible="{Binding HasAutomaticForceQuit}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                        <UniformGrid Columns="2">
                            <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="{StaticResource Round12}" Padding="{StaticResource Inset16}" Margin="{StaticResource Inset0x0x8x8}"><StackPanel Spacing="{StaticResource Measure8}">
                                <TextBlock Text="Asked to close" Foreground="{DynamicResource DangerBrush}" FontWeight="{StaticResource WeightStrong}" />
                                <ItemsControl ItemsSource="{Binding AppsToStop}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="{StaticResource Inset0x3}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock Text="No apps to close." IsVisible="{Binding !HasAppsToStop}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel></Border>
                            <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="{StaticResource Round12}" Padding="{StaticResource Inset16}" Margin="{StaticResource Inset0x0x0x8}"><StackPanel Spacing="{StaticResource Measure8}">
                                <TextBlock Text="Stays open" Foreground="{DynamicResource RunningBrush}" FontWeight="{StaticResource WeightStrong}" />
                                <ItemsControl ItemsSource="{Binding AppsToKeep}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="{StaticResource Inset0x3}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock Text="No already-open apps in this run." IsVisible="{Binding !HasAppsToKeep}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel></Border>
                        </UniformGrid>
                        <TextBlock Text="Apps still opening for this Session will also be asked to close. Apps that were already open stay open." Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="{StaticResource Inset0x22x0x0}">
                    <Button x:Name="CancelEndButton" Content="Cancel" Classes="quiet" IsDefault="True" Command="{Binding CancelEndSessionCommand}" Margin="{StaticResource Inset0x0x10x8}" />
                    <Button x:Name="ConfirmEndButton" Content="Stop apps and end Session" Classes="danger" Command="{Binding ConfirmEndSessionCommand}" Margin="{StaticResource Inset0x0x0x8}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Border>
    <Border IsVisible="{Binding IsDraftCloseConfirmation}" Background="{DynamicResource OverlayBrush}">
        <Border Classes="surface modal" MaxWidth="{StaticResource Measure640}" MaxHeight="{StaticResource Measure520}" Margin="{StaticResource Inset32}" Padding="{StaticResource Inset28}" HorizontalAlignment="Center" VerticalAlignment="Center"
                KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="{Binding DraftCloseTitle}">
            <Border.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding KeepEditingCommand}" /></Border.KeyBindings>
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="{StaticResource Measure16}">
                        <TextBlock Text="{Binding DraftCloseTitle}" FontSize="{DynamicResource FontTitleSize}" FontWeight="{StaticResource WeightHeading}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DraftCloseMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Some settings need attention before you can save. Choose Keep editing to finish them, or discard this draft." IsVisible="{Binding DraftNeedsCorrection}" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource SessionError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="{StaticResource Inset0x22x0x0}">
                    <Button x:Name="KeepEditingButton" Content="Keep editing" Classes="quiet" IsDefault="True" Command="{Binding KeepEditingCommand}" Margin="{StaticResource Inset0x0x10x8}" />
                    <Button x:Name="DiscardDraftButton" Content="Discard" Classes="danger" Command="{Binding DiscardDraftAndCloseCommand}" Margin="{StaticResource Inset0x0x10x8}" />
                    <Button x:Name="SaveDraftButton" Content="Save" Classes="primary" Command="{Binding SaveDraftAndCloseCommand}" Margin="{StaticResource Inset0x0x0x8}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Border>
    <Border IsVisible="{Binding IsCloseConfirmation}" Background="{DynamicResource OverlayBrush}">
        <Border Classes="surface modal" MaxWidth="{StaticResource Measure500}" MaxHeight="{StaticResource Measure520}" Margin="{StaticResource Inset32}" Padding="{StaticResource Inset28}" HorizontalAlignment="Center" VerticalAlignment="Center"
                KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="Close Sessions">
            <Border.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding CancelCloseCommand}" /></Border.KeyBindings>
            <Grid RowDefinitions="*,Auto">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="{StaticResource Measure16}">
                <TextBlock Text="A Session is still active" FontSize="{DynamicResource FontTitleSize}" FontWeight="{StaticResource WeightHeading}" TextWrapping="Wrap" />
                <TextBlock Text="End Session asks its apps to close. Sessions stays open if any apps need your attention. Apps already open stay open." TextWrapping="Wrap" />
                <TextBlock Text="{Binding AutomaticForceQuitWarning}" IsVisible="{Binding HasAutomaticForceQuit}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Spacing="{StaticResource Measure16}" Margin="{StaticResource Inset0x22x0x0}">
                <Button x:Name="KeepSessionsOpenButton" Content="Keep Sessions open" Command="{Binding CancelCloseCommand}" IsDefault="True" Classes="quiet" />
                <Button Content="End Session and close" Command="{Binding EndAndCloseCommand}" Classes="danger" />
                <Button Content="Leave apps open and close" Command="{Binding LeaveAppsAndCloseCommand}" Classes="quiet" />
            </StackPanel>
            </Grid>
        </Border>
    </Border>
    <Border IsVisible="{Binding IsAppCloseConfirmation}" Background="{DynamicResource OverlayBrush}">
        <Border Classes="surface modal" MaxWidth="{StaticResource Measure500}" MaxHeight="{StaticResource Measure520}" Margin="{StaticResource Inset32}" Padding="{StaticResource Inset28}" HorizontalAlignment="Center" VerticalAlignment="Center"
                KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="{Binding AppCloseTitle}">
            <Border.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding CancelCloseAppCommand}" /></Border.KeyBindings>
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="{StaticResource Measure16}">
                        <TextBlock Text="{Binding AppCloseTitle}" FontSize="{DynamicResource FontTitleSize}" FontWeight="{StaticResource WeightHeading}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AppCloseDescription}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AppCloseSessionHint}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="{StaticResource Inset0x22x0x0}">
                    <Button x:Name="CancelCloseAppButton" Content="Cancel" Classes="quiet" IsDefault="True" Command="{Binding CancelCloseAppCommand}" Margin="{StaticResource Inset0x0x10x8}" />
                    <Button x:Name="ConfirmCloseAppButton" Content="{Binding AppCloseButtonLabel}" Classes="danger" Command="{Binding ConfirmCloseAppCommand}" Margin="{StaticResource Inset0x0x0x8}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Border>
    <Border IsVisible="{Binding IsForceQuitConfirmation}" Background="{DynamicResource OverlayBrush}">
        <Border Classes="surface modal" MaxWidth="{StaticResource Measure500}" MaxHeight="{StaticResource Measure520}" Margin="{StaticResource Inset32}" Padding="{StaticResource Inset28}" HorizontalAlignment="Center" VerticalAlignment="Center"
                KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="{Binding ForceQuitTitle}">
            <Border.KeyBindings><KeyBinding Gesture="Escape" Command="{Binding CancelForceQuitCommand}" /></Border.KeyBindings>
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="{StaticResource Measure16}">
                        <TextBlock Text="{Binding ForceQuitTitle}" FontSize="{DynamicResource FontTitleSize}" FontWeight="{StaticResource WeightHeading}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ForceQuitDescription}" TextWrapping="Wrap" />
                        <TextBlock Text="Cancel to return to the app and save your work first." Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="{StaticResource Inset0x22x0x0}">
                    <Button x:Name="CancelForceQuitButton" Content="Cancel" Classes="quiet" IsDefault="True" Command="{Binding CancelForceQuitCommand}" Margin="{StaticResource Inset0x0x10x8}" />
                    <Button x:Name="ConfirmForceQuitButton" Content="Force quit" Classes="danger" Command="{Binding ConfirmForceQuitCommand}" Margin="{StaticResource Inset0x0x0x8}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Border>
    <Border IsVisible="{Binding IsConfirmingDelete}" Background="{DynamicResource OverlayBrush}">
        <Border Classes="surface modal" MaxWidth="{StaticResource Measure480}" Margin="{StaticResource Inset32}" Padding="{StaticResource Inset28}" HorizontalAlignment="Center" VerticalAlignment="Center"
                KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="{Binding DeleteTitle}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelDeleteSessionCommand}" />
            </Border.KeyBindings>
            <Grid RowDefinitions="*,Auto">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Spacing="{StaticResource Measure18}">
                <TextBlock Text="{Binding DeleteTitle}" FontSize="{DynamicResource FontTitleSize}" FontWeight="{StaticResource WeightHeading}" TextWrapping="Wrap" />
                <TextBlock Text="This removes the saved Session and its app settings. This can't be undone." TextWrapping="Wrap" />
                <TextBlock Text="Your installed apps, files, and running apps will stay as they are." Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DeleteErrorMessage}" IsVisible="{Binding HasDeleteError}" AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource SessionError}" TextWrapping="Wrap" />
            </StackPanel>
            </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource Measure12}" HorizontalAlignment="Right" Margin="{StaticResource Inset0x24x0x0}">
                    <Button x:Name="CancelDeleteButton" Content="Cancel" Classes="quiet" IsDefault="True"
                            Command="{Binding CancelDeleteSessionCommand}" />
                    <Button x:Name="ConfirmDeleteButton" Content="{Binding DeleteButtonLabel}" Classes="danger"
                            Command="{Binding ConfirmDeleteSessionCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
    </Grid>
    </LayoutTransformControl>
</Window>
