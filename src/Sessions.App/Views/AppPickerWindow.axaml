<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sessions.App.ViewModels" x:Class="Sessions.App.Views.AppPickerWindow"
        x:DataType="vm:AppPickerViewModel" x:CompileBindings="True"
        Title="Add apps" Width="{StaticResource Measure820}" Height="{StaticResource Measure700}" MinWidth="{StaticResource Measure520}" MinHeight="{StaticResource Measure460}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/sessions.ico">
    <LayoutTransformControl x:Name="AppearanceRoot">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <StackPanel Margin="{StaticResource Inset28x24x28x20}" Spacing="{StaticResource Measure8}">
            <TextBlock Text="Add apps" FontSize="{DynamicResource FontTitleSize}" FontWeight="{StaticResource WeightHeading}" />
            <TextBlock Text="Your selections stay when you switch sources." Classes="muted" TextWrapping="Wrap" />
            <WrapPanel Orientation="Horizontal" Margin="{StaticResource Inset0x8x0x0}">
                <RadioButton x:Name="StartMenuSourceButton" Classes="source" GroupName="AppSources" Content="Start menu" IsChecked="{Binding ShowStartMenu}" IsVisible="{Binding HasStartMenuSource}" Margin="{StaticResource Inset0x0x16x0}" />
                <RadioButton x:Name="RunningSourceButton" Classes="source" GroupName="AppSources" Content="Running apps" IsChecked="{Binding ShowRunningApps}" />
                <RadioButton x:Name="PluginSourceButton" Classes="source" GroupName="AppSources" Content="Plugins" IsChecked="{Binding ShowPlugins}" IsVisible="{Binding HasPluginSource}" Margin="{StaticResource Inset16x0x0x0}" />
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="{StaticResource Inset28x0x28x16}">
            <TextBox x:Name="AppSearch" Text="{Binding SearchText}" PlaceholderText="Search apps" AutomationProperties.Name="Search apps" />
            <Button Grid.Column="1" Content="Refresh" Classes="quiet" Command="{Binding RefreshCommand}" Margin="{StaticResource Inset12x0x0x0}" />
        </Grid>
        <Grid Grid.Row="2" Margin="{StaticResource Inset28x0}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding !IsLoading}">
                <ItemsControl ItemsSource="{Binding VisibleApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppChoiceViewModel">
                            <CheckBox Classes="appChoice" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="{StaticResource Inset10x12}"
                                      AutomationProperties.Name="{Binding App.Name}" AutomationProperties.HelpText="{Binding Status}" ToolTip.Tip="{Binding App.ExecutablePath}">
                                <Grid ColumnDefinitions="40,*" Margin="{StaticResource Inset4x0x0x0}">
                                    <Grid Width="{StaticResource Measure30}" Height="{StaticResource Measure30}" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource SessionSelection}" CornerRadius="{StaticResource Round6}" IsVisible="{Binding !HasIcon}">
                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource Measure4}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding App.Name}" FontWeight="{StaticResource WeightStrong}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel IsVisible="{Binding IsLoading}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource Measure12}">
                <ProgressBar Width="{StaticResource Measure160}" IsIndeterminate="True" />
                <TextBlock Text="Finding your apps…" Classes="muted" />
            </StackPanel>
            <TextBlock IsVisible="{Binding IsEmpty}" Text="{Binding EmptyMessage}" TextWrapping="Wrap" Classes="muted" Margin="{StaticResource Inset12x28}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Row="3" Margin="{StaticResource Inset28x8}" Spacing="{StaticResource Measure10}">
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource SessionError}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SourceDescription}" Classes="muted" FontSize="{DynamicResource FontMicroSize}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="4" BorderBrush="{DynamicResource SessionBorder}" BorderThickness="{StaticResource Inset0x1x0x0}" Padding="{StaticResource Inset28x18}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Button Content="Browse files…" Classes="quiet" Click="BrowseClicked" IsEnabled="{Binding !IsLoading}" HorizontalAlignment="Left" />
                <Button x:Name="PickerCancelButton" Grid.Column="1" Content="Cancel" Classes="quiet" Click="CancelClicked" IsCancel="True" Margin="{StaticResource Inset12x0}" />
                <Button x:Name="AddSelectedButton" Grid.Column="2" Content="{Binding AddLabel}" Classes="primary" IsEnabled="{Binding CanAdd}" Click="AddClicked" />
            </Grid>
        </Border>
    </Grid>
    </LayoutTransformControl>
</Window>
